SUPABASE_URL=https://dhqdlnaaikbrlvcjdpdb.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# AI Rate Limits & Concurrency
AI_RATE_LIMIT_PER_MINUTE=10
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONCURRENT_REQUESTS=1

# AI Streaming Timeouts & Retries
AI_CONNECT_TIMEOUT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=70
AI_FIRST_TOKEN_TIMEOUT_SECONDS=30
AI_FIRST_TOKEN_TIMEOUT_MAX_SECONDS=60
AI_STREAM_READ_TIMEOUT_SECONDS=100
AI_STREAM_READ_TIMEOUT_MAX_SECONDS=105
AI_INTER_CHUNK_TIMEOUT_SECONDS=30
AI_STREAM_KEEPALIVE_INTERVAL_SECONDS=15
AI_STREAM_429_MAX_RETRIES=2
AI_PROVIDER_RETRY_MAX_WAIT_SECONDS=8
AI_MAX_TOKENS=1536

# Groq API Configuration (ATS Analysis Provider)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
ATS_GROQ_MODEL=openai/gpt-oss-120b

# xAI Grok API Configuration (Optional alternative ATS Provider)
XAI_API_KEY=YOUR_XAI_API_KEY
XAI_BASE_URL=https://api.x.ai/v1
ATS_GROK_MODEL=grok-2-latest